# ============================================================================
# Ijaraga Uylar Maklersiz — muhit sozlamalari
# Bu faylni ".env" nomi bilan nusxalab, haqiqiy qiymatlarni kiriting:
#   cp .env.example .env
# .env fayli HECH QACHON git'ga qo'shilmasin (u .gitignore'da).
# ============================================================================

# ---- Telegram bot ----
# @BotFather'dan olingan token. MUHIM: eski repo'da token ochiq holda
# kod ichida yozilgan edi — bu ХАВФЛИ. Agar shu token oldin ochiq holda
# GitHub'ga yuklangan bo'lsa, @BotFather orqali /revoke qilib, YANGI token oling.
BOT_TOKEN=

# Ochiq/yopiq kanal ID'si (raqam, masalan -1001234567890) — e'lonlar shu yerga joylanadi
CHANNEL_ID=
# Kanalning @username'i (kanal ochiq bo'lsa) — havolalar uchun
CHANNEL_USERNAME=

# Admin va moderatorlarning Telegram user_id'lari, vergul bilan ajratilgan
ADMIN_IDS=
# Asosiy adminning @username'i (foydalanuvchilarga ko'rsatiladi)
ADMIN_USERNAME=

# Veb-sayt (dashboard.py) qayerda ishlayotgani — bot shu manzilga havola beradi
# (WebApp xarita/lokatsiya tanlash tugmalari faqat HTTPS bo'lsa ishlaydi!)
# Masalan: https://ijaragauylar.uz
DASHBOARD_URL=

DB_PATH=elonlar.db
MAX_DAILY_LISTINGS=5
MOD_DAILY_LISTINGS=50
STALE_CHECK_DAYS=7

CARD_HOLDER=
CARD_NUMBER=
LISTING_PRICE=20000
SUBSCRIPTION_PRICE=20000
SUBSCRIPTION_DAYS=30
SUBSCRIBER_DISCOUNT_PERCENT=25

# ---- Veb-sayt (dashboard.py) ----
# Admin panel (/admin) uchun login/parol — kuchli parol tanlang!
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

BOT_USERNAME=
INSTAGRAM_URL=https://www.instagram.com/ijaraga_uylar.uz/
