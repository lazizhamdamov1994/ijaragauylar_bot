# ==== Seus bot sozlamalari ====
# Bu faylni nusxa qilib, nomini ".env" qiling va qiymatlarni yozing.
# .env fayli GitHub'ga YUKLANMAYDI (u .gitignore ichida).

# @BotFather bergan token (masalan: 1234567890:AAH...)
BOT_TOKEN=

# PostgreSQL bazasi
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seus
DB_USER=seus
DB_PASSWORD=

# VAQTINCHALIK (PostgreSQL o'rnatilguncha sinash uchun): quyidagi qatordagi # ni olib tashlang.
# Shunda baza seus.db fayliga yoziladi va DB_* qatorlari e'tiborga olinmaydi.
# DATABASE_URL=sqlite+aiosqlite:///seus.db

# Log darajasi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
