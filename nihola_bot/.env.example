# Nusxa oling:  .env.example  ->  .env   va qiymatlarni to'ldiring.
# .env fayli hech qachon GitHub'ga yuklanmaydi (.gitignore'da).

# @BotFather'dan olingan token
BOT_TOKEN=

# Kanal: ochiq bo'lsa @username (masalan @nihola_estate), yopiq bo'lsa -100... raqami
CHANNEL_ID=@nihola_estate

# Adminlar Telegram ID'lari, vergul bilan (o'z ID'ingizni @userinfobot dan bilib oling)
ADMIN_IDS=123456789

# Lidlar (mijoz so'rovlari) shu guruhga tushadi. Bo'sh bo'lsa — har bir adminga shaxsan.
# Guruh ID'si -100... ko'rinishida, botni guruhga qo'shing.
LEADS_CHAT_ID=

# Rieltor ma'lumotlari (postda va mijozga ko'rsatiladi)
REALTOR_NAME=Nihola
REALTOR_PHONE=+998 90 123 45 67
REALTOR_USERNAME=

# Rasmlarga qo'yiladigan suv belgisi (bo'sh qoldirsangiz — qo'yilmaydi)
WATERMARK_TEXT=Nihola Estate

# "Kuniga 1 marta" rejimidagi mijozlarga dayjest soat nechada ketadi
DIGEST_HOUR=19
TIMEZONE=Asia/Tashkent

DB_PATH=nihola.db
MEDIA_DIR=media
